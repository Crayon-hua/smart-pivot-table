{
  "name": "smart-pivot-table",
  "type": "module",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter smart-pivot-table-playground dev",
    "build": "pnpm --filter \"./packages/**\" -r run build",
    "type-check": "pnpm --filter \"./packages/**\" -r run type-check",
    "test": "pnpm --filter @smartv/pivot-core test && pnpm --filter @smartv/pivot-chart test"
  },
  "pnpm": {
    "strictPeerDependencies": false,
    "onlyBuiltDependencies": ["esbuild"]
  }
}
