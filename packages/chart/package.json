{
  "name": "@smart/pivot-chart",
  "type": "module",
  "version": "0.1.0",
  "description": "ECharts pivot chart adapter and Vue component.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Crayon-hua/smart-pivot-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crayon-hua/smart-pivot-table.git",
    "directory": "packages/chart"
  },
  "bugs": {
    "url": "https://github.com/Crayon-hua/smart-pivot-table/issues"
  },
  "keywords": ["pivot", "chart", "echarts", "vue"],
  "sideEffects": ["**/*.css", "**/*.vue"],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["LICENSE", "dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "pnpm type-check && pnpm build",
    "publish:only": "pnpm publish --access public --no-git-checks --no-provenance --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@smart/pivot-core": "workspace:*"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "echarts": "^6.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
