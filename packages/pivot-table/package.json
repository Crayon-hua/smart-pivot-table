{
  "name": "@smartv/pivot-table",
  "type": "module",
  "version": "0.1.3",
  "description": "Open-source Pivot Table + Pivot Chart for Univer OSS.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Crayon-hua/smart-pivot-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crayon-hua/smart-pivot-table.git",
    "directory": "packages/pivot-table"
  },
  "bugs": {
    "url": "https://github.com/Crayon-hua/smart-pivot-table/issues"
  },
  "keywords": ["pivot", "pivot-table", "pivot-chart", "univer", "vue", "spreadsheet"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["LICENSE", "dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm type-check && pnpm build"
  },
  "dependencies": {
    "@smartv/pivot-chart": "workspace:*",
    "@smartv/pivot-core": "workspace:*",
    "@smartv/pivot-univer": "workspace:*",
    "@smartv/pivot-vue": "workspace:*"
  },
  "peerDependencies": {
    "@univerjs/core": ">=0.15.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@univerjs/core": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "pinia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@univerjs/core": "0.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "echarts": "^6.1.0",
    "pinia": "^3.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
