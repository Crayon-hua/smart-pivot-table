{
  "name": "@smartv/pivot-univer",
  "type": "module",
  "version": "0.1.1",
  "description": "Univer OSS adapter: read selection, write pivot sheet, register commands.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Crayon-hua/smart-pivot-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crayon-hua/smart-pivot-table.git",
    "directory": "packages/univer"
  },
  "bugs": {
    "url": "https://github.com/Crayon-hua/smart-pivot-table/issues"
  },
  "keywords": ["pivot", "univer", "spreadsheet", "sheets"],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["LICENSE", "dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm type-check && pnpm build"
  },
  "dependencies": {
    "@smartv/pivot-core": "workspace:*"
  },
  "peerDependencies": {
    "@univerjs/core": ">=0.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@univerjs/core": "0.15.0",
    "typescript": "~5.9.3"
  }
}
