{
  "name": "@smartv/pivot-core",
  "type": "module",
  "version": "0.1.2",
  "description": "Framework-agnostic pivot engine: aggregate, filter, group, and layout.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Crayon-hua/smart-pivot-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crayon-hua/smart-pivot-table.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Crayon-hua/smart-pivot-table/issues"
  },
  "keywords": ["pivot", "pivot-table", "univer", "spreadsheet"],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["LICENSE", "dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm type-check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
